{
  "name": "janwebdev/translatable-entity-bundle",
  "description": "Make Entity translatable",
  "keywords": [
    "symfony",
    "bundle",
    "translatable",
    "translation",
    "i18n",
    "php"
  ],
  "type": "symfony-bundle",
  "homepage": "https://github.com/janwebdev/translatable-entity-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Jan Rogozinsky",
      "email": "janwebdev@gmail.com",
      "role": "PHP developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "symfony/config": "^6.4|^7.0",
    "symfony/dependency-injection": "^6.4|^7.0",
    "symfony/framework-bundle": "^6.4|^7.0",
    "doctrine/orm": "^2.19|^3.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "symfony/test-pack": "^1.0",
    "phpunit/phpunit": "^10.0|^11.0",
    "phpro/grumphp": "^2.0",
    "squizlabs/php_codesniffer": "^3.10",
    "phpstan/phpstan": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "Janwebdev\\TranslatableEntityBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Janwebdev\\TranslatableEntityBundle\\Tests\\": "tests/"
    }
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": "true",
      "require": "^6.4"
    },
    "branch-alias": {
      "dev-master": "2.x-dev"
    }
  },
  "scripts": {
    "test": "./vendor/bin/grumphp run"
  },
  "config": {
    "allow-plugins": {
      "phpro/grumphp": true
    }
  },
  "minimum-stability": "beta",
  "prefer-stable": true
}
